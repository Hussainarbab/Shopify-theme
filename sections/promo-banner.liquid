<section class="promo-section page-width">
  <div class="promo-banner{% if section.settings.image != blank %} promo-banner--image{% endif %}">
    {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: class: 'promo-banner__image', widths: '700, 1000, 1400, 1800', loading: 'lazy', alt: section.settings.heading }}{% endif %}
    <div class="promo-banner__content"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p><a class="button button--light" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a></div>
    <div class="promo-banner__graphic" aria-hidden="true"><span>TN</span></div>
  </div>
</section>
{% schema %}
{"name":"Promotional banner","settings":[
  {"type":"image_picker","id":"image","label":"Background image"},
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"A BETTER SETUP STARTS HERE"},
  {"type":"text","id":"heading","label":"Heading","default":"Your tech, in its element."},
  {"type":"textarea","id":"text","label":"Text","default":"Find the little upgrades that make your desk, commute, and downtime feel just right."},
  {"type":"text","id":"button_label","label":"Button label","default":"Explore all accessories"},
  {"type":"url","id":"link","label":"Link"}
],"presets":[{"name":"Promotional banner"}]}
{% endschema %}
