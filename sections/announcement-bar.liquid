{% if section.settings.show_announcement %}
  <div class="announcement-bar">
    <div class="page-width announcement-bar__inner">
      <span>{{ section.settings.message | escape }}</span>
      {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
    </div>
  </div>
{% endif %}
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {"type":"checkbox","id":"show_announcement","label":"Show announcement","default":true},
    {"type":"text","id":"message","label":"Message","default":"Thoughtful tech. Delivered across Pakistan."},
    {"type":"text","id":"link_label","label":"Link label","default":"Explore the collection"},
    {"type":"url","id":"link","label":"Link"}
  ]
}
{% endschema %}
