<section class="contact-section page-width">
  <div class="contact-intro"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape }}</p>
    {% if settings.business_email != blank %}<p><strong>Email</strong><br><a href="mailto:{{ settings.business_email | escape }}">{{ settings.business_email | escape }}</a></p>{% endif %}
    {% if settings.business_phone != blank %}<p><strong>Phone</strong><br><a href="tel:{{ settings.business_phone | remove: ' ' | escape }}">{{ settings.business_phone | escape }}</a></p>{% endif %}
    {% if settings.business_address != blank %}<p><strong>Address</strong><br>{{ settings.business_address | escape | newline_to_br }}</p>{% endif %}
    {% if settings.instagram_url != blank or settings.facebook_url != blank %}<div class="contact-social">{% if settings.instagram_url != blank %}<a href="{{ settings.instagram_url }}" target="_blank" rel="noopener noreferrer">Instagram</a>{% endif %}{% if settings.facebook_url != blank %}<a href="{{ settings.facebook_url }}" target="_blank" rel="noopener noreferrer">Facebook</a>{% endif %}</div>{% endif %}
    <p class="contact-note">We’ll get back to you as soon as we can during our business hours.</p>
  </div>
  <div class="contact-card">
    {% form 'contact', id: 'ContactForm' %}
      {% if form.posted_successfully? %}<div class="form-status form-status--success" role="status" tabindex="-1">Thanks for getting in touch. Your message has been sent.</div>{% endif %}
      {% if form.errors %}<div class="form-status form-status--error" role="alert" tabindex="-1">{{ form.errors | default_errors }}</div>{% endif %}
      <div class="form-field"><label for="ContactName">Your name</label><input id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}" required></div>
      <div class="form-field"><label for="ContactEmail">Email address</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}" required></div>
      <div class="form-field"><label for="ContactSubject">Subject</label><input id="ContactSubject" type="text" name="contact[subject]" value="{{ form.subject }}" required></div>
      <div class="form-field"><label for="ContactMessage">How can we help?</label><textarea id="ContactMessage" name="contact[body]" rows="6" required>{{ form.body }}</textarea></div>
      <button class="button button--primary" type="submit">Send message <span aria-hidden="true">→</span></button>
    {% endform %}
  </div>
</section>
{% schema %}
{"name":"Contact form","settings":[
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"WE’RE HERE TO HELP"},
  {"type":"text","id":"heading","label":"Heading","default":"Let’s talk tech."},
  {"type":"textarea","id":"text","label":"Text","default":"Need a hand choosing, have an order question, or just want to say hello? Send us a note."},
  {"type":"paragraph","content":"Set the optional business email, phone, address, and social links in Theme settings > Business contact."}
]}
{% endschema %}
