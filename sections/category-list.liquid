<section class="section page-width">
  <div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.link_label != blank %}<a class="text-link" href="{{ routes.all_products_collection_url }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}</div>
  <div class="category-grid">
    {% for block in section.blocks %}
      {% assign category_collection = block.settings.collection %}
      <a class="category-card" href="{% if category_collection != blank %}{{ category_collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: class: 'category-card__image', widths: '300, 500, 800', loading: 'lazy', alt: block.settings.title }}
        {% else %}
          {% render 'category-placeholder', kind: forloop.index, title: block.settings.title, placeholder_id: block.id %}
        {% endif %}
        <span class="category-card__overlay"></span><span class="category-card__content"><strong>{{ block.settings.title | escape }}</strong><span>{{ block.settings.subtitle | escape }}</span></span><span class="category-card__arrow" aria-hidden="true">↗</span>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Featured categories","settings":[
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"FIND YOUR FIT"},
  {"type":"text","id":"heading","label":"Heading","default":"Made for your everyday"},
  {"type":"text","id":"link_label","label":"Link label","default":"Shop all"}
],"blocks":[{"type":"category","name":"Category","settings":[
  {"type":"text","id":"title","label":"Title","default":"Phone essentials"},
  {"type":"text","id":"subtitle","label":"Subtitle","default":"Small things, big difference"},
  {"type":"image_picker","id":"image","label":"Image"},
  {"type":"collection","id":"collection","label":"Collection"}
]}],"max_blocks":4,"presets":[{"name":"Featured categories","blocks":[
  {"type":"category","settings":{"title":"Phone stands","subtitle":"Find your best angle"}},
  {"type":"category","settings":{"title":"Charging","subtitle":"Power through the day"}},
  {"type":"category","settings":{"title":"Audio","subtitle":"Tune into your world"}},
  {"type":"category","settings":{"title":"Everyday carry","subtitle":"Smart tools, on the go"}}
]} ]}
{% endschema %}
