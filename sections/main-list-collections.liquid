<section class="collection-page page-width">
  <header class="collection-header"><p class="eyebrow">EXPLORE TECHNEST</p><h1>{{ section.settings.title | escape }}</h1><p class="collection-description">{{ section.settings.description | escape }}</p></header>
  {% paginate collections by 16 %}
    <div class="category-grid collection-list-grid">
      {% for collection in collections %}
        {% unless collection.handle == 'frontpage' %}
          <a class="category-card" href="{{ collection.url }}">
            {% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | image_tag: class: 'category-card__image', widths: '350, 600, 900', loading: 'lazy', alt: collection.featured_image.alt | default: collection.title }}
            {% elsif collection.products.first.featured_image %}{{ collection.products.first.featured_image | image_url: width: 900 | image_tag: class: 'category-card__image', widths: '350, 600, 900', loading: 'lazy', alt: collection.products.first.title }}
            {% else %}{% render 'category-placeholder', kind: forloop.index, title: collection.title, placeholder_id: collection.id %}{% endif %}
            <span class="category-card__overlay"></span><span class="category-card__content"><strong>{{ collection.title | escape }}</strong><span>{{ collection.products_count }} products</span></span>
          </a>
        {% endunless %}
      {% else %}<p>No collections are available yet.</p>{% endfor %}
    </div>
  {% endpaginate %}
</section>
{% schema %}
{"name":"List collections","settings":[
  {"type":"text","id":"title","label":"Title","default":"Shop all collections"},
  {"type":"text","id":"description","label":"Description","default":"Browse useful tech accessories, organized for how you live and work."}
]}
{% endschema %}
