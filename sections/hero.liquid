<section class="hero">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'hero__image', widths: '750, 1100, 1500, 2000', fetchpriority: 'high', alt: section.settings.image.alt | default: section.settings.heading }}
  {% else %}
    <div class="hero__art" role="img" aria-label="Modern wireless earbuds and accessories on a deep blue background">
      <div class="hero__orb hero__orb--one"></div><div class="hero__orb hero__orb--two"></div>
      <div class="hero__device hero__device--phone"></div><div class="hero__device hero__device--bud"></div><div class="hero__device hero__device--stand"></div>
    </div>
  {% endif %}
  <div class="hero__scrim"></div>
  <div class="page-width hero__content">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1>{{ section.settings.heading | escape }}</h1>
    <p class="hero__copy">{{ section.settings.text | escape }}</p>
    {% if section.settings.button_label != blank %}<a class="button button--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
    <div class="hero__note"><span class="hero__note-dot"></span>{{ section.settings.note | escape }}</div>
  </div>
</section>
{% schema %}
{"name":"Hero banner","settings":[
  {"type":"image_picker","id":"image","label":"Background image"},
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"BETTER TECH, EVERY DAY"},
  {"type":"text","id":"heading","label":"Heading","default":"Small upgrades. A better connected life."},
  {"type":"textarea","id":"text","label":"Description","default":"Discover thoughtful accessories that make your everyday tech work beautifully. Curated for you, delivered across Pakistan."},
  {"type":"text","id":"button_label","label":"Button label","default":"Shop accessories"},
  {"type":"url","id":"button_link","label":"Button link"},
  {"type":"text","id":"note","label":"Small note","default":"Useful by design · Selected with care"}
],"presets":[{"name":"Hero banner"}]}
{% endschema %}
