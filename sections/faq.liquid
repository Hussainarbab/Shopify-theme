<section class="content-page faq-page page-width">
  <header class="content-page__header"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.intro | escape }}</p></header>
  <div class="faq-list">{% for block in section.blocks %}<details class="faq-item" {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary><div class="rte">{{ block.settings.answer }}</div></details>{% endfor %}</div>
  <p class="faq-contact">Still have a question? <a href="{{ section.settings.contact_link | default: '/pages/contact' }}">Get in touch with us</a>.</p>
</section>
{% schema %}
{"name":"FAQ","settings":[
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"GOOD TO KNOW"},
  {"type":"text","id":"heading","label":"Heading","default":"Frequently asked questions"},
  {"type":"textarea","id":"intro","label":"Intro","default":"A few helpful answers to get you started. For anything else, just reach out."},
  {"type":"url","id":"contact_link","label":"Contact page link"}
],"blocks":[{"type":"faq","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Where do you deliver?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Delivery availability, rates, and estimated timing are confirmed at checkout based on your address.</p>"}]}],"max_blocks":12,"presets":[{"name":"FAQ","blocks":[
  {"type":"faq","settings":{"question":"Where do you deliver?","answer":"<p>Delivery coverage and available shipping options are shown at checkout for your address in Pakistan.</p>"}},
  {"type":"faq","settings":{"question":"How can I track my order?","answer":"<p>Once your order is dispatched, any tracking information available will be shared using the contact details provided at checkout.</p>"}},
  {"type":"faq","settings":{"question":"What payment methods can I use?","answer":"<p>Available payment methods are displayed during checkout and may depend on your location and Shopify store settings.</p>"}},
  {"type":"faq","settings":{"question":"Can I return or exchange an item?","answer":"<p>Please review our return and refund policy for current eligibility and instructions. Contact us before sending an item back.</p>"}},
  {"type":"faq","settings":{"question":"How do I get product help?","answer":"<p>Use our contact page and include the product name and your question. We’ll do our best to help.</p>"}}
]}]}
{% endschema %}
