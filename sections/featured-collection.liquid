<section class="section page-width">
  <div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.description != blank %}<p class="section-heading__copy">{{ section.settings.description | escape }}</p>{% endif %}</div>{% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}</div>
  {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
    <div class="product-grid">
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  {% else %}
    <div class="empty-collection"><p>Products will appear here once you add them to this collection.</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Browse all products →</a></div>
  {% endif %}
</section>
{% schema %}
{"name":"Featured collection","settings":[
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE GOOD STUFF"},
  {"type":"text","id":"heading","label":"Heading","default":"Everyday favourites"},
  {"type":"textarea","id":"description","label":"Description","default":"Well-designed essentials, picked to make your setup work harder."},
  {"type":"collection","id":"collection","label":"Collection"},
  {"type":"range","id":"products_to_show","min":2,"max":8,"step":1,"default":4,"label":"Products to show"},
  {"type":"text","id":"link_label","label":"Link label","default":"View all"},
  {"type":"checkbox","id":"show_vendor","label":"Show vendor","default":false}
],"presets":[{"name":"Featured collection"}]}
{% endschema %}
