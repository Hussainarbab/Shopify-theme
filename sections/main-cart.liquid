<section class="cart-page page-width">
  <div class="section-heading"><div><p class="eyebrow">YOUR PICKS</p><h1>Your cart</h1></div><a class="text-link" href="{{ routes.all_products_collection_url }}">Continue shopping →</a></div>
  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" id="CartForm">
      <div class="cart-lines">
        <div class="cart-lines__header"><span>Product</span><span>Quantity</span><span>Total</span></div>
        {% for item in cart.items %}
          <div class="cart-line">
            <a class="cart-line__image" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.image.alt | default: item.product.title }}{% endif %}</a>
            <div class="cart-line__product"><a class="cart-line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}<p class="price">{{ item.final_price | money }}</p>{% if item.properties.size > 0 %}{% for property in item.properties %}{% assign property_first_char = property.first | slice: 0 %}{% unless property_first_char == '_' %}<p>{{ property.first }}: {{ property.last }}</p>{% endunless %}{% endfor %}{% endif %}<a class="cart-remove" href="{{ item.url_to_remove }}">Remove</a></div>
            <label class="visually-hidden" for="CartQty-{{ forloop.index }}">Quantity for {{ item.product.title | escape }}</label><input class="cart-quantity" id="CartQty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity">
            <strong class="cart-line__total">{{ item.final_line_price | money }}</strong>
          </div>
        {% endfor %}
      </div>
      <div class="cart-summary"><div class="cart-subtotal"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div><p>Shipping and taxes calculated at checkout.</p>
        <label for="CartNote">Order note (optional)</label><textarea id="CartNote" name="note" rows="3">{{ cart.note }}</textarea>
        <button class="button button--outline" type="submit" name="update">Update cart</button><button class="button button--primary" type="submit" name="checkout">Continue to checkout <span aria-hidden="true">→</span></button>
      </div>
    </form>
  {% else %}
    <div class="empty-state"><span class="empty-state__icon" aria-hidden="true">⌁</span><h2>Your cart is taking a little break</h2><p>There’s nothing here yet. Find a useful little upgrade for your everyday.</p><a class="button button--primary" href="{{ routes.all_products_collection_url }}">Explore accessories</a></div>
  {% endif %}
</section>
{% schema %}{"name":"Main cart"}{% endschema %}
