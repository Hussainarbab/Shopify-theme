<section class="benefits-section">
  <div class="page-width">
    <div class="section-heading section-heading--center"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div></div>
    <div class="benefit-grid">
      {% for block in section.blocks %}<div class="benefit-card" {{ block.shopify_attributes }}><span class="benefit-card__icon" aria-hidden="true">{{ block.settings.icon | escape }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></div>{% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Why shop with us","settings":[
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE TECHNEST DIFFERENCE"},
  {"type":"text","id":"heading","label":"Heading","default":"Good tech. No guesswork."}
],"blocks":[{"type":"benefit","name":"Benefit","settings":[
  {"type":"text","id":"icon","label":"Icon","default":"✦"},
  {"type":"text","id":"title","label":"Title","default":"Thoughtfully picked"},
  {"type":"text","id":"text","label":"Text","default":"Useful accessories selected with real everyday needs in mind."}
]}],"max_blocks":4,"presets":[{"name":"Why shop with us","blocks":[
  {"type":"benefit","settings":{"icon":"✦","title":"Thoughtfully picked","text":"Useful accessories selected with real everyday needs in mind."}},
  {"type":"benefit","settings":{"icon":"↗","title":"Pakistan-wide delivery","text":"Shipping options and timelines are shown at checkout."}},
  {"type":"benefit","settings":{"icon":"♡","title":"Here to help","text":"Have a question? Our team is ready to help you choose."}},
  {"type":"benefit","settings":{"icon":"⌁","title":"Easy checkout","text":"A straightforward, secure Shopify-powered checkout."}}
]}]}
{% endschema %}
