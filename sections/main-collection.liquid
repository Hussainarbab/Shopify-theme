<section class="collection-page page-width">
  <header class="collection-header">
    <p class="eyebrow">THE TECHNEST EDIT</p><h1>{{ collection.title | escape }}</h1>
    {% if collection.description != blank %}<div class="collection-description rte">{{ collection.description }}</div>{% else %}<p class="collection-description">Useful tech accessories, thoughtfully chosen for everyday life.</p>{% endif %}
  </header>
  {% paginate collection.products by section.settings.products_per_page %}
    <div class="collection-toolbar">
      <span class="collection-count">{{ collection.products_count }} products</span>
      <form class="collection-sort" id="SortForm">
        <label for="SortBy">Sort by</label>
        <select id="SortBy" name="sort_by" data-sort-select>
          {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
          {% for option in collection.sort_options %}<option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}
        </select>
      </form>
    </div>
    {% if collection.filters.size > 0 %}
      <form class="filter-form" id="CollectionFilters">
        <input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}">
        {% for filter in collection.filters %}
          <details class="filter-group"><summary>{{ filter.label | escape }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary>
            <div class="filter-group__options">
              {% case filter.type %}
                {% when 'list' %}
                  {% for value in filter.values %}<label class="filter-option"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}><span>{{ value.label | escape }} ({{ value.count }})</span></label>{% endfor %}
                {% when 'boolean' %}
                  <label class="filter-option"><input type="checkbox" name="{{ filter.param_name }}" value="{{ filter.true_value.value }}" {% if filter.true_value.active %}checked{% endif %}><span>{{ filter.label | escape }}</span></label>
                {% when 'price_range' %}
                  <div class="price-range"><label>Min <input name="{{ filter.min_value.param_name }}" type="number" min="0" max="{{ filter.range_max | money_without_currency | replace: ',', '' }}" placeholder="0" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"></label><label>Max <input name="{{ filter.max_value.param_name }}" type="number" min="0" max="{{ filter.range_max | money_without_currency | replace: ',', '' }}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"></label></div>
              {% endcase %}
            </div>
          </details>
        {% endfor %}
        <button class="button button--small" type="submit">Apply filters</button>
        {% if collection.url %}<a class="text-link" href="{{ collection.url }}">Clear all</a>{% endif %}
      </form>
    {% endif %}
    {% if collection.products.size > 0 %}
      <div class="product-grid product-grid--collection">
        {% for product in collection.products %}{% render 'product-card', product: product %}{% endfor %}
      </div>
      {% if paginate.pages > 1 %}<nav class="pagination" aria-label="Pagination">
        {% if paginate.previous %}<a href="{{ paginate.previous.url }}" aria-label="Previous page">← Previous</a>{% endif %}
        <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {% if paginate.next %}<a href="{{ paginate.next.url }}" aria-label="Next page">Next →</a>{% endif %}
      </nav>{% endif %}
    {% else %}
      <div class="empty-state"><span class="empty-state__icon" aria-hidden="true">⌁</span><h2>Nothing to see just yet</h2><p>There are no products in this collection right now. Check back soon or browse the full store.</p><a class="button button--primary" href="{{ routes.all_products_collection_url }}">Browse all products</a></div>
    {% endif %}
  {% endpaginate %}
</section>
{% schema %}
{"name":"Main collection","settings":[
  {"type":"range","id":"products_per_page","min":8,"max":32,"step":4,"default":16,"label":"Products per page"},
  {"type":"checkbox","id":"show_vendor","label":"Show vendor","default":false}
]}
{% endschema %}
