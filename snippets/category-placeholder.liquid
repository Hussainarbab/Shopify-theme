{% assign category_name = title | downcase %}
{% assign category_asset = '' %}
{% if category_name contains 'stand' %}
  {% assign category_asset = 'product-phone-stand.jpg' %}
{% elsif category_name contains 'charge' or category_name contains 'power' %}
  {% assign category_asset = 'product-charger.jpg' %}
{% elsif category_name contains 'audio' or category_name contains 'earbud' or category_name contains 'headphone' %}
  {% assign category_asset = 'product-earbuds.jpg' %}
{% elsif category_name contains 'keyboard' or category_name contains 'mouse' or category_name contains 'desk' %}
  {% assign category_asset = 'product-keyboard.jpg' %}
{% elsif category_name contains 'everyday' or category_name contains 'carry' %}
  {% assign category_asset = 'product-powerbank.jpg' %}
{% elsif category_name contains 'cable' %}
  {% assign category_asset = 'product-usbc-cable.jpg' %}
{% elsif category_name contains 'phone' or category_name contains 'holder' or category_name contains 'mount' %}
  {% assign category_asset = 'product-phone-holder.jpg' %}
{% elsif kind == 1 %}
  {% assign category_asset = 'product-phone-stand.jpg' %}
{% elsif kind == 2 %}
  {% assign category_asset = 'product-charger.jpg' %}
{% elsif kind == 3 %}
  {% assign category_asset = 'product-earbuds.jpg' %}
{% elsif kind == 4 %}
  {% assign category_asset = 'product-powerbank.jpg' %}
{% endif %}

{% if category_asset != blank %}
  <img class="category-card__image" src="{{ category_asset | asset_url }}" alt="{{ title | escape }} accessories" width="1000" height="1100" loading="lazy">
{% else %}
  {% render 'category-art-placeholder', title: title, placeholder_id: placeholder_id %}
{% endif %}
