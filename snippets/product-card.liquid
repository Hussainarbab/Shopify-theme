{% assign card_product = product %}
<article class="product-card">
  <a class="product-card__media" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
    {% render 'product-image', product: card_product, class: 'product-card__image', image_width: 720, image_widths: '240, 360, 540, 720', loading: 'lazy' %}
    {% if card_product.compare_at_price > card_product.price %}<span class="product-badge">Save {{ card_product.compare_at_price | minus: card_product.price | times: 100.0 | divided_by: card_product.compare_at_price | round }}%</span>{% endif %}
    {% unless card_product.available %}<span class="product-badge product-badge--sold">Sold out</span>{% endunless %}
  </a>
  <div class="product-card__details">
    {% if section.settings.show_vendor and card_product.vendor != blank %}<p class="product-card__vendor">{{ card_product.vendor | escape }}</p>{% endif %}
    <h3><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
    <div class="price">
      {% if card_product.compare_at_price > card_product.price %}<span class="price__current price__current--sale">{{ card_product.price | money }}</span><s class="price__compare">{{ card_product.compare_at_price | money }}</s>
      {% else %}<span class="price__current">{{ card_product.price | money }}</span>{% endif %}
    </div>
  </div>
</article>
